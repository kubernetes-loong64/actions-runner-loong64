ARG BASE_IMAGE=lcr.loongnix.cn/debian:14
FROM $BASE_IMAGE

ARG RUNNER_BRANCH=v2.335.1
ARG DOCKER_CLI_VERSION=v29.7.1+1

LABEL maintainer="xuxiaowei@xuxiaowei.com.cn" \
      org.opencontainers.image.title="LoongArch GitHub Actions Runner" \
      org.opencontainers.image.description="GitHub Actions Runner for LoongArch (loong64) architecture" \
      org.opencontainers.image.version="${RUNNER_BRANCH}" \
      org.opencontainers.image.url="https://github.com/kubernetes-loong64/actions-runner-loong64" \
      org.opencontainers.image.source="https://github.com/kubernetes-loong64/actions-runner-loong64" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        sudo \
        curl \
        git \
        libssl-dev \
        libicu-dev \
        ca-certificates \
    && VERSION_NO_V=$(echo "${RUNNER_BRANCH}" | sed 's/^v//') \
    && RUNNER_TARBALL="actions-runner-linux-loongarch64-${VERSION_NO_V}.tar.gz" \
    && RUNNER_URL="https://github.com/loong64/runner/releases/download/${RUNNER_BRANCH}/${RUNNER_TARBALL}" \
    && echo "Downloading runner from: ${RUNNER_URL}" \
    && useradd -m -s /bin/bash runner \
    && usermod -aG sudo runner \
    && echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/runner \
    && chmod 440 /etc/sudoers.d/runner \
    && mkdir -p /home/runner/actions-runner \
    && cd /home/runner/actions-runner \
    && curl -fsSL "${RUNNER_URL}" -o "${RUNNER_TARBALL}" \
    && tar xzf "${RUNNER_TARBALL}" \
    && rm "${RUNNER_TARBALL}" \
    && chown -R runner:runner /home/runner/actions-runner \
    && ./bin/installdependencies.sh \
    && DOCKER_CLI_VERSION_NO_V=$(echo "${DOCKER_CLI_VERSION}" | sed 's/^v//') \
    && DOCKER_CLI_PKG_VERSION=$(echo "${DOCKER_CLI_VERSION_NO_V}" | sed 's/+/-/') \
    && DOCKER_CLI_URL="https://github.com/kubernetes-loong64/cli-loong64/releases/download/release-loong64-${DOCKER_CLI_VERSION}/docker-ce-cli_${DOCKER_CLI_PKG_VERSION}.debian.13.trixie_loong64.deb" \
    && echo "Downloading Docker CLI from: ${DOCKER_CLI_URL}" \
    && curl -fsSL "${DOCKER_CLI_URL}" -o /tmp/docker-ce-cli.deb \
    && dpkg -i /tmp/docker-ce-cli.deb \
    && rm /tmp/docker-ce-cli.deb \
    && rm -rf /var/lib/apt/lists/* \
    && su runner -c "./run.sh --help" \
    && docker --version

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER runner
WORKDIR /home/runner/actions-runner
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
