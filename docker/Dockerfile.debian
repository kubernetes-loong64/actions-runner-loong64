ARG BASE_IMAGE=lcr.loongnix.cn/debian:14
FROM $BASE_IMAGE

ARG GIT_BRANCH=v2.335.1

LABEL maintainer="xuxiaowei@xuxiaowei.com.cn" \
      org.opencontainers.image.title="LoongArch GitHub Actions Runner" \
      org.opencontainers.image.description="GitHub Actions Runner for LoongArch (loong64) architecture" \
      org.opencontainers.image.version="${GIT_BRANCH}" \
      org.opencontainers.image.url="https://github.com/kubernetes-loong64/actions-runner-loong64" \
      org.opencontainers.image.source="https://github.com/kubernetes-loong64/actions-runner-loong64" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        ; \
    rm -rf /var/lib/apt/lists/*; \
    \
    VERSION_NO_V=$(echo "${GIT_BRANCH}" | sed 's/^v//'); \
    RUNNER_TARBALL="actions-runner-linux-loongarch64-${VERSION_NO_V}.tar.gz"; \
    RUNNER_URL="https://github.com/loong64/runner/releases/download/${GIT_BRANCH}/${RUNNER_TARBALL}"; \
    echo "Downloading runner from: ${RUNNER_URL}"; \
    \
    useradd -m -s /bin/bash runner; \
    mkdir -p /home/runner/actions-runner; \
    cd /home/runner/actions-runner; \
    curl -fsSL "${RUNNER_URL}" -o "${RUNNER_TARBALL}"; \
    tar xzf "${RUNNER_TARBALL}"; \
    rm "${RUNNER_TARBALL}"; \
    chown -R runner:runner /home/runner/actions-runner

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER runner
WORKDIR /home/runner/actions-runner
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
